  { category: "weather", icon: "☀️", en: "sunny", kana: "サニー", jp: "晴れ" },
  { category: "weather", icon: "🌧️", en: "rainy", kana: "レイニー", jp: "雨" },
  { category: "weather", icon: "☁️", en: "cloudy", kana: "クラウディ", jp: "くもり" },
