const GRAMMAR_GUIDE_DATA = [
  { tag: "状態・感想", pattern: "It is [ 形容詞 ].", example: "It is fun.", jp: "それは〜です。" },
  { tag: "好きなもの", pattern: "I like [ 名詞 ].", example: "I like music.", jp: "私は〜が好きです。" },
  { tag: "好きなこと", pattern: "I like [ 動詞ing ].", example: "I like playing soccer.", jp: "私は〜することが好きです。" },
  { tag: "持っているもの", pattern: "I have [ 名詞 ].", example: "I have a dog.", jp: "私は〜を持っています。" },
  { tag: "紹介", pattern: "This is [ 名詞 ].", example: "This is my school.", jp: "これは〜です。" },
  { tag: "質問", pattern: "Do you like [ 名詞 ]?", example: "Do you like cats?", jp: "あなたは〜が好きですか？" },
  { tag: "答え", pattern: "Yes, I do. / No, I don't.", example: "Yes, I do.", jp: "はい、好きです。／いいえ、好きではありません。" },
  { tag: "将来の夢", pattern: "I want to be a [ 職業 ].", example: "I want to be a teacher.", jp: "私は〜になりたいです。" },
  { tag: "やりたいこと", pattern: "I want to [ 動詞 ].", example: "I want to help people.", jp: "私は〜したいです。" },
  { tag: "できること", pattern: "I can [ 動詞 ].", example: "I can swim fast.", jp: "私は〜ができます。" },
  { tag: "できないこと", pattern: "I can't [ 動詞 ].", example: "I can't fly.", jp: "私は〜できません。" },
  { tag: "得意なこと", pattern: "I am good at [ 名詞 / 動詞ing ].", example: "I am good at drawing.", jp: "私は〜が得意です。" },
  { tag: "行った場所", pattern: "I went to [ 場所 ].", example: "I went to Kyoto.", jp: "私は〜へ行きました。" },
  { tag: "過去のこと", pattern: "I [ 過去形の動詞 ].", example: "I played basketball.", jp: "私は〜しました。" },
  { tag: "思い出", pattern: "I enjoyed [ 名詞 ].", example: "I enjoyed the school trip.", jp: "私は〜を楽しみました。" },
  { tag: "一番好きなもの", pattern: "My favorite season is [ 季節 ].", example: "My favorite season is spring.", jp: "私の一番好きな季節は〜です。" },
  { tag: "住んでいる場所", pattern: "I live in [ 場所 ].", example: "I live in Tokyo.", jp: "私は〜に住んでいます。" },
  { tag: "町の紹介", pattern: "There is [ 場所 ] in my town.", example: "There is a big park in my town.", jp: "私の町には〜があります。" },
  { tag: "週末の習慣", pattern: "I usually [ 動詞 ] on weekends.", example: "I usually read books on weekends.", jp: "私は週末によく〜します。" },
  { tag: "行きたい場所", pattern: "I want to go to [ 場所 ].", example: "I want to go to France.", jp: "私は〜へ行きたいです。" },
  { tag: "人物の紹介", pattern: "He / She is very [ 形容詞 ].", example: "She is very kind.", jp: "彼／彼女はとても〜です。" },
  { tag: "尊敬する人", pattern: "I admire [ 人 ].", example: "I admire my mother.", jp: "私は〜を尊敬しています。" },
  { tag: "理由", pattern: "Because it is [ 形容詞 ].", example: "Because it is exciting.", jp: "なぜなら、それは〜だからです。" },
  { tag: "お礼", pattern: "Thank you for listening.", example: "Thank you for listening.", jp: "聞いてくれてありがとうございます。" }
];

let currentTopicKey = "";
let currentReasonIndex = null;
let currentSelectedWord = "";
let toastTimer = null;

function showToast(message) {
  const toast = document.getElementById("toast");
  toast.textContent = message;
  toast.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove("show"), 3000);
}

function updateSpeechRateLabel() {
  const rate = Number(document.getElementById("speechRate").value);
  document.getElementById("speechRateValue").textContent = `${rate.toFixed(1)}×`;
}

function getBritishMaleVoice() {
  if (!("speechSynthesis" in window)) return null;

  const voices = window.speechSynthesis.getVoices();
  const maleNameHints = [
    "male", "man", "daniel", "arthur", "george",
    "oliver", "ryan", "lee", "alfie", "fred"
  ];

  return voices.find(voice =>
    /^en-GB$/i.test(voice.lang) &&
    maleNameHints.some(hint => voice.name.toLowerCase().includes(hint))
  ) || null;
}

function speakWithBritishMaleVoice(text) {
  if (!("speechSynthesis" in window)) {
    showToast("このブラウザは音声読み上げに対応していません。");
    return;
  }

  const voice = getBritishMaleVoice();
  if (!voice) {
    showToast("男性のイギリス英語音声が見つかりません。端末の音声設定をご確認ください。");
    return;
  }

  window.speechSynthesis.cancel();

  const utterance = new SpeechSynthesisUtterance(text);
  utterance.voice = voice;
  utterance.lang = "en-GB";
  utterance.rate = Number(document.getElementById("speechRate").value);
  window.speechSynthesis.speak(utterance);
}

function speakSingleWord(text) {
  speakWithBritishMaleVoice(text);
}

function switchTab(tabId) {
  ["speech", "vocab", "grammar"].forEach((id, index) => {
    document.querySelectorAll(".tab-btn")[index].classList.toggle("active", id === tabId);
    document.getElementById(`tab-${id}`).classList.toggle("active", id === tabId);
  });

  if (tabId === "vocab") renderVocabCards();
  if (tabId === "grammar") renderGrammarGuide();
}

function makeWordCard(card, onSelect) {
  const cardEl = document.createElement("div");
  cardEl.className = "word-card";
  cardEl.setAttribute("role", "button");
  cardEl.setAttribute("tabindex", "0");
  cardEl.setAttribute("aria-label", `${card.en}, ${card.jp}`);
  cardEl.innerHTML = `
    <div class="card-icon">${card.icon}</div>
    <div class="card-en">${card.en}</div>
    <div class="card-kana">${card.kana}</div>
    <div class="card-jp">${card.jp}</div>
  `;

  cardEl.addEventListener("click", onSelect);
  cardEl.addEventListener("keydown", event => {
    if (event.key === "Enter" || event.key === " ") {
      event.preventDefault();
      onSelect();
    }
  });

  return cardEl;
}

function renderVocabCards() {
  const category = document.getElementById("vocabCategory").value;
  const deck = document.getElementById("vocabCardDeck");
  deck.innerHTML = "";

  const words = category === "all"
    ? VOCAB_DATA
    : VOCAB_DATA.filter(item => item.category === category);

  words.forEach(card => {
    deck.appendChild(makeWordCard(card, () => speakSingleWord(card.en)));
  });
}

function renderGrammarGuide() {
  const grid = document.getElementById("grammarListGrid");
  if (grid.innerHTML.trim()) return;

  GRAMMAR_GUIDE_DATA.forEach(item => {
    const el = document.createElement("div");
    el.className = "grammar-item-card";
    el.setAttribute("role", "button");
    el.setAttribute("tabindex", "0");
    el.title = "クリックすると発音します";
    el.innerHTML = `
      <div class="grammar-item-tag">${item.tag}</div>
      <div class="grammar-item-pat">${item.pattern}</div>
      <div style="font-size:14px;font-weight:bold;color:#2D3748;margin-top:4px;">
        例: ${item.example}
      </div>
      <div class="grammar-item-jp">${item.jp}</div>
    `;

    const readExample = () => speakSingleWord(item.example);
    el.addEventListener("click", readExample);
    el.addEventListener("keydown", event => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        readExample();
      }
    });

    grid.appendChild(el);
  });
}

function selectTopic(key, button) {
  currentTopicKey = key;
  currentReasonIndex = null;
  currentSelectedWord = "";
  document.getElementById("customInput").value = "";

  document.querySelectorAll(".topic-btn").forEach(btn => btn.classList.remove("active"));
  button.classList.add("active");

  const topic = TOPICS[key];
  const reasonGrid = document.getElementById("reasonGrid");
  reasonGrid.innerHTML = "";

  topic.reasons.forEach((reason, index) => {
    const btn = document.createElement("button");
    btn.className = "reason-btn";
    btn.textContent = `💡 ${reason.jp}`;
    btn.addEventListener("click", () => selectReason(index));
    reasonGrid.appendChild(btn);
  });

  document.getElementById("step2").style.display = "block";
  document.getElementById("step3").style.display = "none";
  updatePreview(`${topic.intro}\n\n(STEP 2で内容をえらんでね)`);
}

function selectReason(index) {
  currentReasonIndex = index;
  currentSelectedWord = "";
  document.getElementById("customInput").value = "";

  const topic = TOPICS[currentTopicKey];
  const reason = topic.reasons[index];

  document.querySelectorAll(".reason-btn").forEach((btn, i) => {
    btn.classList.toggle("active", i === index);
  });

  document.getElementById("grammarBox").innerHTML = `
    <div>【使いたい文法パターン】</div>
    <div class="grammar-hint">${reason.grammar}</div>
  `;

  const deck = document.getElementById("cardDeck");
  deck.innerHTML = "";

  reason.cards.forEach(card => {
    const cardEl = makeWordCard(card, () => {
      document.querySelectorAll("#cardDeck .word-card").forEach(item => {
        item.classList.remove("selected");
        item.setAttribute("aria-selected", "false");
      });

      cardEl.classList.add("selected");
      cardEl.setAttribute("aria-selected", "true");
      currentSelectedWord = card.en;
      document.getElementById("customInput").value = card.en;
      speakSingleWord(card.en);
      renderSpeech();
    });

    cardEl.setAttribute("aria-selected", "false");
    deck.appendChild(cardEl);
  });

  document.getElementById("step3").style.display = "block";
  renderSpeech();
}

document.getElementById("customInput").addEventListener("input", event => {
  currentSelectedWord = event.target.value;

  document.querySelectorAll("#cardDeck .word-card").forEach(card => {
    card.classList.remove("selected");
    card.setAttribute("aria-selected", "false");
  });

  renderSpeech();
});

function renderSpeech() {
  if (!currentTopicKey || currentReasonIndex === null) return;

  const topic = TOPICS[currentTopicKey];
  const reason = topic.reasons[currentReasonIndex];
  let line = reason.grammar;

  if (currentSelectedWord.trim()) {
    line = line.replace(/\[[^\]]*\]/, currentSelectedWord.trim());
  }

  updatePreview(`${topic.intro}\n${line}\nThank you for listening.`);
}

function updatePreview(text) {
  document.getElementById("previewText").innerText = text;
}

function speakText() {
  speakWithBritishMaleVoice(document.getElementById("previewText").innerText);
}

function copyText() {
  const text = document.getElementById("previewText").innerText;

  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(text)
      .then(() => showToast("📋 原稿をコピーしました！"))
      .catch(() => fallbackCopyText(text));
  } else {
    fallbackCopyText(text);
  }
}

function fallbackCopyText(text) {
  const textArea = document.createElement("textarea");
  textArea.value = text;
  textArea.style.position = "fixed";
  textArea.style.left = "-9999px";
  document.body.appendChild(textArea);
  textArea.select();

  try {
    const copied = document.execCommand("copy");
    showToast(copied ? "📋 原稿をコピーしました！" : "コピーに失敗しました。");
  } catch (error) {
    showToast("コピーに失敗しました。");
  } finally {
    document.body.removeChild(textArea);
  }
}

updateSpeechRateLabel();

if ("speechSynthesis" in window) {
  window.speechSynthesis.onvoiceschanged = () => {
    window.speechSynthesis.getVoices();
  };
}
</script>
</body>
</html>
