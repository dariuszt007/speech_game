<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>外国語 スピーチ・発表サポーター</title>
  <style>
    :root {
      --primary: #2B6CB0;
      --primary-light: #EBF8FF;
      --secondary: #DD6B20;
      --secondary-light: #FFFAF0;
      --green: #38A169;
      --green-hover: #2F855A;
      --bg: #EDF2F7;
      --text: #2D3748;
      --muted: #718096;
      --border: #CBD5E0;
    }

    * { box-sizing: border-box; }

    body {
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial,
        "Hiragino Kaku Gothic ProN", "Meiryo", sans-serif;
      background: var(--bg);
      color: var(--text);
      margin: 0;
      padding: 16px;
      line-height: 1.5;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
      background: #fff;
      padding: 24px;
      border-radius: 16px;
      box-shadow: 0 4px 15px rgba(0,0,0,.08);
    }

    h1 {
      text-align: center;
      color: var(--primary);
      font-size: 24px;
      margin: 0 0 20px;
    }

    .tab-nav {
      display: flex;
      gap: 8px;
      margin-bottom: 20px;
      border-bottom: 2px solid var(--border);
      padding-bottom: 8px;
      overflow-x: auto;
    }

    .tab-btn {
      background: #E2E8F0;
      border: 0;
      padding: 10px 18px;
      font-size: 15px;
      font-weight: bold;
      border-radius: 8px;
      cursor: pointer;
      color: #4A5568;
      white-space: nowrap;
    }

    .tab-btn:hover { background: #CBD5E0; }
    .tab-btn.active { background: var(--primary); color: #fff; }

    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .step-box {
      background: var(--primary-light);
      border-left: 6px solid var(--primary);
      padding: 16px;
      margin-bottom: 20px;
      border-radius: 8px;
    }

    .step-title {
      font-weight: bold;
      font-size: 18px;
      color: #1A365D;
      margin-bottom: 12px;
    }

    select, input[type="text"] {
      width: 100%;
      font-size: 16px;
      padding: 12px;
      border-radius: 8px;
      border: 2px solid var(--border);
      background: #fff;
    }

    select:focus, input[type="text"]:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(43,108,176,.2);
    }

    .topic-grid, .reason-grid, .grammar-list-grid {
      display: grid;
      gap: 12px;
    }

    .topic-grid { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
    .reason-grid { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }

    .topic-btn, .reason-btn {
      background: #fff;
      border: 2px solid var(--primary);
      color: var(--primary);
      padding: 14px;
      font-size: 16px;
      font-weight: bold;
      border-radius: 10px;
      cursor: pointer;
      text-align: left;
    }

    .topic-btn:hover, .reason-btn:hover { background: #E2E8F0; }
    .topic-btn.active, .reason-btn.active { background: var(--primary); color: #fff; }

    .grammar-box {
      background: var(--secondary-light);
      border: 2px dashed var(--secondary);
      padding: 16px;
      border-radius: 8px;
      margin-top: 12px;
    }

    .grammar-hint {
      font-size: 20px;
      font-weight: bold;
      color: #C05621;
      margin-top: 4px;
    }

    .card-deck {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
      gap: 12px;
      margin-top: 12px;
    }

    .word-card {
      background: #fff;
      border: 2px solid var(--border);
      border-radius: 10px;
      padding: 12px;
      text-align: center;
      cursor: pointer;
      transition: transform .1s, border-color .2s, box-shadow .2s;
      user-select: none;
    }

    .word-card:hover, .word-card:focus {
      transform: translateY(-2px);
      border-color: var(--secondary);
      outline: none;
    }

    .word-card.selected {
      border-color: var(--secondary);
      background: var(--secondary-light);
      box-shadow: 0 0 8px rgba(221,107,32,.4);
    }

    .card-icon { font-size: 32px; margin-bottom: 4px; }
    .card-en { font-weight: bold; font-size: 17px; }
    .card-kana { font-size: 12px; color: var(--muted); margin-bottom: 2px; }
    .card-jp { font-size: 13px; color: var(--primary); font-weight: bold; }

    .preview-box {
      background: #2D3748;
      color: #fff;
      padding: 20px;
      border-radius: 12px;
      margin-top: 24px;
    }

    .preview-title { font-size: 16px; color: #A0AEC0; margin-bottom: 8px; }
    .preview-text {
      font-size: 20px;
      line-height: 1.8;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .controls {
      display: flex;
      gap: 12px;
      margin-top: 16px;
      flex-wrap: wrap;
    }

    .action-btn {
      flex: 1;
      min-width: 180px;
      padding: 12px;
      font-size: 16px;
      font-weight: bold;
      border: 0;
      border-radius: 8px;
      cursor: pointer;
    }

    .action-btn:active { transform: scale(.98); }
    .btn-speak { background: var(--green); color: #fff; }
    .btn-speak:hover { background: var(--green-hover); }
    .btn-copy { background: #4299E1; color: #fff; }
    .btn-copy:hover { background: #3182CE; }

    .speed-control {
      flex: 1 1 100%;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      font-weight: bold;
      color: #fff;
    }

    .speed-control input {
      flex: 1;
      min-width: 140px;
      accent-color: #68D391;
    }

    .grammar-list-grid {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      margin-top: 12px;
    }

    .grammar-item-card {
      background: #fff;
      border: 2px solid var(--border);
      border-radius: 8px;
      padding: 14px;
      cursor: pointer;
      transition: transform .1s, border-color .2s;
    }

    .grammar-item-card:hover, .grammar-item-card:focus {
      transform: translateY(-2px);
      border-color: var(--primary);
      outline: none;
    }

    .grammar-item-tag {
      font-size: 12px;
      background: var(--secondary-light);
      color: var(--secondary);
      padding: 2px 8px;
      border-radius: 4px;
      font-weight: bold;
      display: inline-block;
      margin-bottom: 6px;
    }

    .grammar-item-pat { font-size: 16px; font-weight: bold; color: var(--primary); }
    .grammar-item-jp { font-size: 13px; color: var(--muted); margin-top: 4px; }

    .toast {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      background: #2D3748;
      color: #fff;
      padding: 12px 24px;
      border-radius: 8px;
      box-shadow: 0 4px 12px rgba(0,0,0,.15);
      font-weight: bold;
      opacity: 0;
      transition: opacity .3s;
      pointer-events: none;
      z-index: 1000;
      width: max-content;
      max-width: calc(100% - 32px);
    }

    .toast.show { opacity: 1; }

    @media (max-width: 600px) {
      body { padding: 8px; }
      .container { padding: 16px; }
      h1 { font-size: 20px; }
    }
  </style>
</head>
<body>

<div class="container">
  <h1>🎤 小学校外国語 スピーチ・発表サポーター</h1>

  <div class="tab-nav">
    <button class="tab-btn active" onclick="switchTab('speech')">🎤 スピーチ作成</button>
    <button class="tab-btn" onclick="switchTab('vocab')">📚 索引・単語帳</button>
    <button class="tab-btn" onclick="switchTab('grammar')">📖 かんたん文法ガイド</button>
  </div>

  <div id="tab-speech" class="tab-content active">
    <div class="step-box">
      <div class="step-title">STEP 1: はっぴょうするトピックをえらぼう</div>
      <div class="topic-grid">
        <button class="topic-btn" onclick="selectTopic('dream', this)">✨ 将来の夢 (My Future Dream)</button>
        <button class="topic-btn" onclick="selectTopic('memories', this)">🏫 小学校の思い出 (My Memories)</button>
        <button class="topic-btn" onclick="selectTopic('can', this)">⚽ できること・得意なこと (What I Can Do)</button>
        <button class="topic-btn" onclick="selectTopic('favorites', this)">🍕 好きなもの・季節 (My Favorites)</button>
        <button class="topic-btn" onclick="selectTopic('town', this)">🏙️ わたしの町・学校紹介 (My Town & School)</button>
        <button class="topic-btn" onclick="selectTopic('weekend', this)">📅 週末・休日の過ごし方 (My Weekend)</button>
        <button class="topic-btn" onclick="selectTopic('hero', this)">👨‍👩‍👧‍👦 家族・お友達の紹介 (My Hero / Family)</button>
        <button class="topic-btn" onclick="selectTopic('world', this)">🌏 行ってみたい国 (Countries I Want to Visit)</button>
      </div>
    </div>

    <div class="step-box" id="step2" style="display:none;">
      <div class="step-title">STEP 2: つたえたい内容をえらぼう（日本語）</div>
      <div class="reason-grid" id="reasonGrid"></div>
    </div>

    <div class="step-box" id="step3" style="display:none;">
      <div class="step-title">STEP 3: えいごのぶんぽうパターンと単語カード</div>
      <div class="grammar-box" id="grammarBox"></div>
      <div style="margin-top:16px;">
        <b>📚 つかえる単語カード（クリックで単語が入ります）:</b>
        <div class="card-deck" id="cardDeck"></div>
      </div>
      <div style="margin-top:16px;">
        <label for="customInput"><b>✏️ 自分で自由に入力する（または変更する）:</b></label>
        <input type="text" id="customInput" placeholder="カードを選ぶか、直接英語を入力" style="margin-top:6px;">
      </div>
    </div>
  </div>

  <div id="tab-vocab" class="tab-content">
    <div class="step-box">
      <div class="step-title">📚 カテゴリ別 単語帳（クリックすると発音が聞けるよ！）</div>
      <div style="margin-bottom:12px;">
        <label for="vocabCategory"><b>ジャンルをえらぶ:</b></label>
        <select id="vocabCategory" onchange="renderVocabCards()" style="margin-top:6px;">
          <option value="all">🌟 すべての単語 (All Words)</option>
          <option value="jobs">👨‍🏫 職業・なりたいもの (Jobs)</option>
          <option value="actions_past">🏃 過去形の動詞 (Past Verbs)</option>
          <option value="actions_present">⚽ 動作・現在形 (Verbs / Present)</option>
          <option value="places_countries">🗽 場所・国名 (Places & Countries)</option>
          <option value="nouns_things">🍕 食べ物・季節・名詞 (Nouns)</option>
          <option value="animals">🐾 動物 (Animals)</option>
          <option value="sports">⚽ スポーツ (Sports)</option>
          <option value="food_drinks">🍎 食べ物・飲み物 (Food & Drinks)</option>
          <option value="school">🏫 学校 (School)</option>
          <option value="colors">🎨 色 (Colors)</option>
          <option value="adjectives">😊 様子・気持ち (Adjectives & Feelings)</option>
          <option value="weather">☀️ 天気・季節 (Weather & Seasons)</option>
          <option value="family">👨‍👩‍👧‍👦 家族 (Family)</option>
        </select>
      </div>
      <div class="card-deck" id="vocabCardDeck"></div>
    </div>
  </div>

  <div id="tab-grammar" class="tab-content">
    <div class="step-box">
      <div class="step-title">📖 小学校でつかえる かんたん文法ガイド</div>
      <p style="margin-top:0;color:var(--muted);">
        スピーチや発表で役立つ基本の文法パターンです。クリックすると例文が読み上げられます！
      </p>
      <div class="grammar-list-grid" id="grammarListGrid"></div>
    </div>
  </div>

  <div class="preview-box">
    <div class="preview-title">【原稿プレビュー / Speech Preview】</div>
    <div class="preview-text" id="previewText">トピックを選択するとここに英語の例文ができます。</div>
    <div class="controls">
      <label class="speed-control" for="speechRate">
        読み上げ速度:
        <input type="range" id="speechRate" min="0.6" max="1.2" step="0.1"
          value="0.9" oninput="updateSpeechRateLabel()">
        <span id="speechRateValue">0.9×</span>
      </label>
      <button class="action-btn btn-speak" onclick="speakText()">🔊 英語をよみあげる</button>
      <button class="action-btn btn-copy" onclick="copyText()">📋 原稿をコピーする</button>
    </div>
  </div>
</div>

<div id="toast" class="toast" role="status" aria-live="polite"></div>

<script>
const TOPICS = {
  dream: {
    intro: "Hello, everyone. I want to tell you about my dream.",
    reasons: [
      {
        jp: "【職業】〜になりたい",
        grammar: "I want to be a [ 職業 ].",
        cards: [
          { icon: "👨‍🏫", en: "teacher", kana: "ティーチャー", jp: "先生" },
          { icon: "👩‍⚕️", en: "doctor", kana: "ドクター", jp: "医者" },
          { icon: "🥐", en: "baker", kana: "ベイカー", jp: "パン屋さん" },
          { icon: "🎮", en: "game creator", kana: "ゲーム クリエイター", jp: "ゲーム制作者" },
          { icon: "⚽", en: "soccer player", kana: "サッカー プレイヤー", jp: "サッカー選手" },
          { icon: "🎨", en: "artist", kana: "アーティスト", jp: "芸術家" },
          { icon: "👮", en: "police officer", kana: "ポリス オフィサー", jp: "警察官" },
          { icon: "👨‍🚒", en: "firefighter", kana: "ファイヤーファイター", jp: "消防士" },
          { icon: "🎤", en: "singer", kana: "シンガー", jp: "歌手" },
          { icon: "🐶", en: "vet", kana: "ベット", jp: "獣医" },
          { icon: "🚀", en: "astronaut", kana: "アストロノート", jp: "宇宙飛行士" },
          { icon: "🧑‍🔬", en: "scientist", kana: "サイエンティスト", jp: "科学者" },
          { icon: "👩‍⚕️", en: "nurse", kana: "ナース", jp: "看護師" },
          { icon: "🧑‍🌾", en: "farmer", kana: "ファーマー", jp: "農家" },
          { icon: "📷", en: "photographer", kana: "フォトグラファー", jp: "写真家" }
        ]
      },
      {
        jp: "【したいこと】〜をしたい",
        grammar: "I want to [ 動詞 ].",
        cards: [
          { icon: "🤝", en: "help people", kana: "ヘルプ ピープル", jp: "人を助ける" },
          { icon: "😊", en: "make people happy", kana: "メイク ピープル ハッピー", jp: "人を幸せにする" },
          { icon: "✈️", en: "travel around the world", kana: "トラベル アラウンド ザ ワールド", jp: "世界中を旅する" },
          { icon: "🍳", en: "cook delicious food", kana: "クック デリシャス フード", jp: "おいしい料理を作る" },
          { icon: "📚", en: "teach children", kana: "ティーチ チルドレン", jp: "子どもたちに教える" },
          { icon: "🐾", en: "help animals", kana: "ヘルプ アニマルズ", jp: "動物を助ける" }
        ]
      },
      {
        jp: "【仕事】〜で働きたい",
        grammar: "I want to work at [ 場所 ].",
        cards: [
          { icon: "🏥", en: "a hospital", kana: "ア ホスピタル", jp: "病院" },
          { icon: "🏫", en: "a school", kana: "ア スクール", jp: "学校" },
          { icon: "🐾", en: "an animal hospital", kana: "アン アニマル ホスピタル", jp: "動物病院" },
          { icon: "🍽️", en: "a restaurant", kana: "ア レストラン", jp: "レストラン" }
        ]
      }
    ]
  },

  memories: {
    intro: "Hello, everyone. I want to talk about my memories.",
    reasons: [
      {
        jp: "【行った場所】〜へ行った",
        grammar: "I went to [ 場所 ].",
        cards: [
          { icon: "🏞️", en: "the park", kana: "ザ パーク", jp: "公園" },
          { icon: "⛩️", en: "Kyoto", kana: "キョウト", jp: "京都" },
          { icon: "🎢", en: "an amusement park", kana: "アン アミューズメント パーク", jp: "遊園地" },
          { icon: "🏖️", en: "the beach", kana: "ザ ビーチ", jp: "海岸" },
          { icon: "🦁", en: "the zoo", kana: "ザ ズー", jp: "動物園" },
          { icon: "📚", en: "the library", kana: "ザ ライブラリー", jp: "図書館" }
        ]
      },
      {
        jp: "【過去】したことを紹介する",
        grammar: "I [ 過去形の動作 ].",
        cards: [
          { icon: "🏀", en: "played basketball", kana: "プレイド バスケットボール", jp: "バスケをした" },
          { icon: "🍜", en: "ate delicious food", kana: "エイト デリシャス フード", jp: "おいしいものを食べた" },
          { icon: "🎶", en: "enjoyed the music festival", kana: "エンジョイド ザ ミュージック フェスティバル", jp: "音楽会を楽しんだ" },
          { icon: "🎤", en: "sang a song", kana: "サング ア ソング", jp: "歌を歌った" },
          { icon: "📸", en: "took pictures", kana: "トゥック ピクチャーズ", jp: "写真を撮った" },
          { icon: "🎂", en: "made a cake", kana: "メイド ア ケイク", jp: "ケーキを作った" }
        ]
      },
      {
        jp: "【思い出】学校行事を楽しんだ",
        grammar: "I enjoyed [ 行事 ].",
        cards: [
          { icon: "🏕️", en: "the school trip", kana: "ザ スクール トリップ", jp: "修学旅行" },
          { icon: "🏃", en: "sports day", kana: "スポーツ デー", jp: "運動会" },
          { icon: "🎵", en: "the school concert", kana: "ザ スクール コンサート", jp: "音楽会" },
          { icon: "🎪", en: "the school festival", kana: "ザ スクール フェスティバル", jp: "学校のお祭り" }
        ]
      }
    ]
  },

  can: {
    intro: "Hello, everyone. Today I'll talk about what I can do.",
    reasons: [
      {
        jp: "【できること】〜ができる",
        grammar: "I can [ 動詞 ].",
        cards: [
          { icon: "🏊", en: "swim fast", kana: "スウィム ファスト", jp: "速く泳ぐ" },
          { icon: "🎸", en: "play the guitar", kana: "プレイ ザ ギター", jp: "ギターを弾く" },
          { icon: "💻", en: "use a computer", kana: "ユーズ ア コンピュータ", jp: "パソコンを使う" },
          { icon: "🗣️", en: "speak English", kana: "スピーク イングリッシュ", jp: "英語を話す" },
          { icon: "🎹", en: "play the piano", kana: "プレイ ザ ピアノ", jp: "ピアノを弾く" },
          { icon: "💃", en: "dance well", kana: "ダンス ウェル", jp: "上手に踊る" },
          { icon: "🍳", en: "cook curry", kana: "クック カレー", jp: "カレーを作る" },
          { icon: "🖼️", en: "paint pictures", kana: "ペイント ピクチャーズ", jp: "絵を描く" },
          { icon: "♟️", en: "play chess", kana: "プレイ チェス", jp: "チェスをする" }
        ]
      },
      {
        jp: "【得意なこと】〜が得意",
        grammar: "I am good at [ 名詞 / 動詞ing ].",
        cards: [
          { icon: "⚽", en: "playing soccer", kana: "プレイング サッカー", jp: "サッカーをすること" },
          { icon: "🎨", en: "drawing pictures", kana: "ドローイング ピクチャーズ", jp: "絵を描くこと" },
          { icon: "📐", en: "math", kana: "マス", jp: "算数" },
          { icon: "🎤", en: "singing", kana: "シンギング", jp: "歌うこと" },
          { icon: "🍳", en: "cooking", kana: "クッキング", jp: "料理をすること" }
        ]
      }
    ]
  },

  favorites: {
    intro: "Hello, everyone. Let me talk about my favorite things.",
    reasons: [
      {
        jp: "【一番好きなもの】好きなものを紹介する",
        grammar: "My favorite thing is [ 名詞 ].",
        cards: [
          { icon: "🍦", en: "ice cream", kana: "アイスクリーム", jp: "アイスクリーム" },
          { icon: "📚", en: "English", kana: "イングリッシュ", jp: "英語" },
          { icon: "🎮", en: "video games", kana: "ビデオ ゲームズ", jp: "テレビゲーム" },
