// 文法ガイドデータ
const GRAMMAR_GUIDE_DATA = [
  { tag: "状態・感想", pattern: "It is [ 形容詞 ].", example: "It is fun.", jp: "それは〜です。（おいしい / たのしい など）" },
  { tag: "好きなもの", pattern: "I like [ 名詞 / 動詞ing ].", example: "I like soccer.", jp: "私は〜が好きです。" },
  { tag: "持っているもの", pattern: "I have [ 名詞 ].", example: "I have a dog.", jp: "私は〜を持っています。" },
  { tag: "紹介・指さし", pattern: "This is [ 名詞 ].", example: "This is my school.", jp: "これは〜です。" },
  { tag: "質問（好き？）", pattern: "Do you like [ 名詞 ]?", example: "Do you like summer?", jp: "あなたは〜が好きですか？" },
  { tag: "将来の夢", pattern: "I want to be a [ 職業 ].", example: "I want to be a teacher.", jp: "私は〜になりたいです。" },
  { tag: "やりたい動作", pattern: "I want to [ 動詞の原形 ].", example: "I want to eat pizza.", jp: "私は〜したいです。" },
  { tag: "できること", pattern: "I can [ 動詞の原形 ].", example: "I can swim fast.", jp: "私は〜ができます。" },
  { tag: "得意なこと", pattern: "I am good at [ 動詞ing / 名詞 ].", example: "I am good at math.", jp: "私は〜が得意です。" },
  { tag: "行った場所", pattern: "I went to [ 場所 ].", example: "I went to Kyoto.", jp: "私は〜へ行きました。" },
  { tag: "思い出・過去", pattern: "I [ 過去形動詞 ].", example: "I played basketball.", jp: "私は〜しました。" },
  { tag: "一番好きなもの", pattern: "My favorite [ 種類 ] is [ 名詞 ].", example: "My favorite season is spring.", jp: "私の1番好きな〜は〜です。" },
  { tag: "住んでいる場所", pattern: "I live in [ 場所 ].", example: "I live in Tokyo.", jp: "私は〜に住んでいます。" },
  { tag: "人物の紹介", pattern: "He / She is very [ 形容詞 ].", example: "She is very kind.", jp: "彼 / 彼女はとても〜です。" }
];

let currentTopicKey = "";
let currentReasonIndex = null;
let currentSelectedWord = "";

// トースト通知を表示
function showToast(msg) {
  const toast = document.getElementById("toast");
  toast.innerText = msg;
  toast.classList.add("show");
  setTimeout(() => {
    toast.classList.remove("show");
  }, 2500);
}

// タブ切り替え機能
function switchTab(tabId) {
  const tabs = ['speech', 'vocab', 'grammar'];
  tabs.forEach((id, index) => {
    const btn = document.querySelectorAll(".tab-btn")[index];
    const content = document.getElementById(`tab-${id}`);
    if (id === tabId) {
      btn.classList.add("active");
      content.classList.add("active");
    } else {
      btn.classList.remove("active");
      content.classList.remove("active");
    }
  });

  if (tabId === 'vocab') {
    renderVocabCards();
  } else if (tabId === 'grammar') {
    renderGrammarGuide();
  }
}

// 単語帳カードの描画
function renderVocabCards() {
  const category = document.getElementById("vocabCategory").value;
  const deck = document.getElementById("vocabCardDeck");
  deck.innerHTML = "";

  const filtered = category === "all" ? VOCAB_DATA : VOCAB_DATA.filter(item => item.category === category);

  filtered.forEach(card => {
    const cardEl = document.createElement("div");
    cardEl.className = "word-card";
    cardEl.setAttribute("role", "button");
    cardEl.setAttribute("tabindex", "0");
    cardEl.innerHTML = `
      <div class="card-icon">${card.icon}</div>
      <div class="card-en">${card.en}</div>
      <div class="card-kana">${card.kana}</div>
      <div class="card-jp">${card.jp}</div>
    `;
    cardEl.onclick = () => speakSingleWord(card.en);
    cardEl.onkeydown = (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        speakSingleWord(card.en);
      }
    };
    deck.appendChild(cardEl);
  });
}

// 文法ガイドの描画
function renderGrammarGuide() {
  const grid = document.getElementById("grammarListGrid");
  if (grid.innerHTML.trim() !== "") return;

  GRAMMAR_GUIDE_DATA.forEach(item => {
    const el = document.createElement("div");
    el.className = "grammar-item-card";
    el.setAttribute("role", "button");
    el.setAttribute("tabindex", "0");
    el.innerHTML = `
      <div class="grammar-item-tag">${item.tag}</div>
      <div class="grammar-item-pat">${item.pattern}</div>
      <div style="font-size:14px; font-weight:bold; color:#2D3748; margin-top:4px;">例: ${item.example}</div>
      <div class="grammar-item-jp">${item.jp}</div>
    `;
    el.title = "クリックすると発音します";
    el.onclick = () => speakSingleWord(item.example);
    el.onkeydown = (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        speakSingleWord(item.example);
      }
    };
    grid.appendChild(el);
  });
}

// 単一単語・文の音声読み上げ（OS組み込み音声ライブラリを利用するためオフラインでも稼働可能）
function speakSingleWord(text) {
  if (!('speechSynthesis' in window)) {
    showToast("お使いのブラウザは音声読み上げに対応していません。");
    return;
  }
  window.speechSynthesis.cancel();
  const uttr = new SpeechSynthesisUtterance(text);
  uttr.lang = 'en-US';
  uttr.rate = 0.85;
  const voices = window.speechSynthesis.getVoices();
  const englishVoice = voices.find(v => v.lang.startsWith('en'));
  if (englishVoice) uttr.voice = englishVoice;
  window.speechSynthesis.speak(uttr);
}

function selectTopic(key, btnElement) {
  currentTopicKey = key;
  currentReasonIndex = null;
  currentSelectedWord = "";
  document.getElementById("customInput").value = "";

  // ボタンのアクティブ状態切り替え
  const topicBtns = document.querySelectorAll(".topic-btn");
  topicBtns.forEach(btn => btn.classList.remove("active"));
  btnElement.classList.add("active");

  const step2 = document.getElementById("step2");
  const step3 = document.getElementById("step3");
  const reasonGrid = document.getElementById("reasonGrid");

  reasonGrid.innerHTML = "";
  const topic = TOPICS[currentTopicKey];
  topic.reasons.forEach((r, idx) => {
    const btn = document.createElement("button");
    btn.className = "reason-btn";
    btn.innerHTML = `💡 ${r.jp}`;
    btn.onclick = () => selectReason(idx);
    reasonGrid.appendChild(btn);
  });

  step2.style.display = "block";
  step3.style.display = "none";
  updatePreview(topic.intro + "\n\n(STEP 2で内容をえらんでね)");
}

function selectReason(idx) {
  currentReasonIndex = idx;
  currentSelectedWord = "";
  document.getElementById("customInput").value = "";

  const topic = TOPICS[currentTopicKey];
  const reason = topic.reasons[idx];

  const btns = document.querySelectorAll(".reason-btn");
  btns.forEach((btn, i) => btn.classList.toggle("active", i === idx));

  const grammarBox = document.getElementById("grammarBox");
  grammarBox.innerHTML = `
    <div>【使いたい文法パターン】</div>
    <div class="grammar-hint">${reason.grammar}</div>
  `;

  const cardDeck = document.getElementById("cardDeck");
  cardDeck.innerHTML = "";
  reason.cards.forEach((card) => {
    const cardEl = document.createElement("div");
    cardEl.className = "word-card";
    cardEl.setAttribute("role", "button");
    cardEl.setAttribute("tabindex", "0");
    cardEl.setAttribute("aria-label", `${card.en}, ${card.jp}`);
    cardEl.innerHTML = `
      <div class="card-icon">${card.icon}</div>
      <div class="card-en">${card.en}</div>
      <div class="card-kana">${card.kana}</div>
      <div class="card-jp">${card.jp}</div>
    `;

    const handleSelect = () => {
      document.querySelectorAll("#cardDeck .word-card").forEach(c => {
        c.classList.remove("selected");
        c.setAttribute("aria-selected", "false");
      });
      cardEl.classList.add("selected");
      cardEl.setAttribute("aria-selected", "true");
      currentSelectedWord = card.en;
      document.getElementById("customInput").value = card.en;
      speakSingleWord(card.en);
      renderSpeech();
    };

    cardEl.onclick = handleSelect;
    cardEl.onkeydown = (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        handleSelect();
      }
    };

    cardDeck.appendChild(cardEl);
  });

  document.getElementById("step3").style.display = "block";
  renderSpeech();
}

document.getElementById("customInput").addEventListener("input", function(e) {
  currentSelectedWord = e.target.value;
  renderSpeech();
});

function renderSpeech() {
  if (!currentTopicKey || currentReasonIndex === null) return;

  const topic = TOPICS[currentTopicKey];
  const reason = topic.reasons[currentReasonIndex];

  let line2 = reason.grammar;
  if (currentSelectedWord.trim() !== "") {
    line2 = line2.replace(/\[.*?\]/, currentSelectedWord.trim());
  }

  const speech = `${topic.intro}\n${line2}\nThank you for listening.`;
  updatePreview(speech);
}

function updatePreview(text) {
  document.getElementById("previewText").innerText = text;
}

function speakText() {
  const text = document.getElementById("previewText").innerText;
  if (!('speechSynthesis' in window)) {
    showToast("お使いのブラウザは音声読み上げに対応していません。");
    return;
  }
  window.speechSynthesis.cancel();
  const uttr = new SpeechSynthesisUtterance(text);
  uttr.lang = 'en-US';
  uttr.rate = 0.85;

  const voices = window.speechSynthesis.getVoices();
  const englishVoice = voices.find(v => v.lang.startsWith('en'));
  if (englishVoice) {
    uttr.voice = englishVoice;
  }

  window.speechSynthesis.speak(uttr);
}

function copyText() {
  const text = document.getElementById("previewText").innerText;
  
  // モダンなコピー機能および、ローカルファイル用フォールバック処理
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(text).then(() => {
      showToast("📋 原稿をコピーしました！");
    }).catch(() => {
      fallbackCopyText(text);
    });
  } else {
    fallbackCopyText(text);
  }
}

function fallbackCopyText(text) {
  try {
    const textArea = document.createElement("textarea");
    textArea.value = text;
    textArea.style.position = "fixed";
    textArea.style.left = "-9999px";
    document.body.appendChild(textArea);
    textArea.select();
    document.execCommand("copy");
    document.body.removeChild(textArea);
    showToast("📋 原稿をコピーしました！");
  } catch (err) {
    showToast("コピーに失敗しました。");
  }
}

// 音声リストの事前ロード（Chromeなどのブラウザ対応）
if ('speechSynthesis' in window) {
  window.speechSynthesis.onvoiceschanged = () => {
    window.speechSynthesis.getVoices();
  };
}
</script>
</body>
</html>
