          { icon: "🗽", en: "America", kana: "アメリカ", jp: "アメリカ" },
          { icon: "🗼", en: "France", kana: "フランス", jp: "フランス" },
          { icon: "🦘", en: "Australia", kana: "オーストラリア", jp: "オーストラリア" }
        ]
      },
      {
        jp: "【動作】〜を見たい・食べたい",
        grammar: "I want to [ 動作 ].",
        cards: [
          { icon: "🍕", en: "eat real pizza", kana: "イート リアル ピザ", jp: "本場のピザを食べる" },
          { icon: "🏰", en: "see famous castles", kana: "シー フェイマス キャッスルズ", jp: "有名な城を見る" }
